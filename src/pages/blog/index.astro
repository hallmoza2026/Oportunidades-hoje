---
import Base from '../../layouts/Base.astro';
import { posts } from '../../lib/posts.js';
import { fmtData, config } from '../../lib/data.js';
---
<Base title="Blog" description="Conselhos práticos para procurar emprego: CV, entrevistas e como evitar burlas." path="/blog/">
  <h1>Blog</h1>
  <ul class="posts">
    {posts.map((p) => (
      <li>
        <h2><a href={`/blog/${p.slug}/`}>{p.title}</a></h2>
        <p>{p.description}</p>
        <p><time datetime={p.date}>{fmtData(p.date)}</time></p>
      </li>
    ))}
  </ul>
  {config.newsletter?.url && (
    <p class="nota">Quer receber novos artigos por e-mail? <a href={config.newsletter.url} rel="noopener">Subscrever</a>.</p>
  )}
</Base>
